{
  "name": "iobroker.switchbot-cloud",
  "version": "0.1.7",
  "description": "ioBroker adapter for SwitchBot devices using API v1.1",
  "author": {
    "name": "ioBroker Community",
    "email": "info@iobroker.net"
  },
  "homepage": "https://github.com/kaschtn/ioBroker.switchbot-cloud",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "switchbot",
    "Smart Home",
    "home automation",
    "IoT"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaschtn/ioBroker.switchbot-cloud.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.2.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^4.0.0",
    "@alcalzone/release-script-plugin-license": "^4.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.1",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/testing": "^5.1.1",
    "@types/node": "^26.4.1",
    "chai": "^4.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.3"
  },
  "main": "main.js",
  "files": [
    "admin/",
    "lib/",
    "test/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js",
    ".eslintrc.js"
  ],
  "scripts": {
    "test": "npm run test:package && npm run test:unit && npm run test:integration",
    "test:package": "mocha test/testPackageFiles.js --timeout 10000",
    "test:unit": "mocha test/unit.js --timeout 15000",
    "test:integration": "mocha test/integration.js --timeout 30000",
    "test:js": "mocha test/unit.js --timeout 10000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev-server": "dev-server",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  },
  "bugs": {
    "url": "https://github.com/kaschtn/ioBroker.switchbot-cloud/issues"
  },
  "readmeFilename": "README.md"
}
